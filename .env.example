# Copy to .env and adjust. Not committed (see .gitignore).

# Default: local SQLite file at instance/app.db - leave unset for this.
# DATABASE_URL=sqlite:///instance/app.db

# To use PostgreSQL instead, set this and no code changes are needed:
# DATABASE_URL=postgresql+psycopg2://ai_wasteguard:password@localhost:5432/ai_wasteguard

# Account lockout policy
# ACCOUNT_LOCKOUT_THRESHOLD=5
# ACCOUNT_LOCKOUT_MINUTES=15

# API (api/main.py) - REQUIRED to override before any real deployment.
# The default is dev-only; anyone who reads this repo knows it.
# API_SECRET_KEY=generate-a-long-random-value-and-put-it-here
# API_TOKEN_EXPIRY_MINUTES=60

# Comma-separated list of origins allowed to call the API from a browser.
# Empty (default) means no browser origin is allowed - non-browser clients
# (curl, server-to-server, the OpenAPI docs at /docs) are unaffected.
# CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
